<!DOCTYPE html>
<html lang="es" class="dark">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Panel de administración</title>
    <script src="https://cdn.tailwindcss.com"></script>
</head>

<body class="bg-gray-900 text-white min-h-screen flex items-center justify-center px-4">
    <div class="w-full max-w-lg p-6 sm:p-8 bg-gray-800 rounded-lg shadow-lg text-center space-y-6">

        <% if (authorized) { %>
            <h1 class="text-3xl font-bold text-blue-400">Panel de Administración</h1>
            <p class="text-lg">Bienvenido,
                <span class="font-semibold text-white">
                    <%= username %>
                </span>
            </p>
        <% } else { %>
            <h1 class="text-2xl font-bold text-red-500">Acceso denegado</h1>
            <p class="text-sm text-gray-300">No estás autorizado para ver esta página.</p>
            <a href="/" class="mt-4 inline-block text-blue-400 hover:underline">Volver al inicio</a>
            <% } %>

    </div>
</body>

</html>